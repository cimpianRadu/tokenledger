# Copy to `.env` and fill in. Both are optional: with no website id the
# analytics script is not emitted at all, and the privacy page drops its
# analytics section to match.

# Umami website id (Settings → Websites → Edit → Website ID).
PUBLIC_UMAMI_WEBSITE_ID=

# Only needed for a self-hosted Umami. Defaults to Umami Cloud.
# PUBLIC_UMAMI_SRC=https://analytics.example.com/script.js
