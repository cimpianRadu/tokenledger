---
import { encode } from 'gpt-tokenizer/encoding/o200k_base';
import Base from '../../layouts/Base.astro';
import Ledger from '../../components/Ledger.tsx';
import {
  models,
  providers,
  orderedProviders,
  modelsFor,
  defaultModelFor,
  tierOf,
  formatPrice,
  seoTitle,
  seoDescription,
  updatedAt,
} from '../../lib/models';
import { driftFor, REFERENCE_TEXT } from '../../lib/tokenizer';

export function getStaticPaths() {
  return providers.map((p) => ({
    params: { provider: p.slug },
    props: { provider: p },
  }));
}

const { provider } = Astro.props;
const drift = driftFor(provider.key);
const exact = provider.counting === 'exact';

/**
 * Tokens per word, measured at build time rather than quoted from anyone.
 *
 * The often-repeated "one token is 0.75 words" is an OpenAI figure for English
 * prose, and repeating it on a Claude page would be wrong twice over — wrong
 * encoder, and stated as fact when this site cannot run Anthropic's. So the
 * reference paragraph goes through the encoder we do have and the family ratio
 * is applied on top, which is exactly what the tool itself does.
 */
const baseTokens = encode(REFERENCE_TEXT).length;
const refWords = REFERENCE_TEXT.trim().split(/\s+/).length;
const refChars = REFERENCE_TEXT.length;
const familyTokens = Math.round(baseTokens * drift);
const tokensPerWord = familyTokens / refWords;
const charsPerToken = refChars / familyTokens;
/** Rounded to the nearest ten, because a figure like 1,317 reads as a
 *  precision the ±10% estimate does not have. */
const per1000Words = Math.round((tokensPerWord * 1000) / 10) * 10;

const list = modelsFor(provider.key).sort((a, b) => a.input - b.input);
/** The rows of the cost table: current models only, capped. A provider with 49
 *  listed models is mostly legacy snapshots, and pricing a 2024 build against
 *  a token count is a question nobody is asking. */
const priced = list.filter((m) => tierOf(m) === 'current').slice(0, 10);
const table = priced.length ? priced : list.slice(0, 10);
/**
 * "From $x" quotes a row the reader can find on this page. Taking `list[0]`
 * instead names the cheapest of everything, which at most providers is a
 * two-year-old dated snapshot — a true number attached to a model nobody is
 * choosing, and one the table below does not even show.
 */
const cheapest = table.reduce((lo, m) => (m.input < lo.input ? m : lo), table[0]);

const VOLUMES = [1_000, 10_000, 100_000, 1_000_000];
const cost = (rate: number, tokens: number) => (rate * tokens) / 1_000_000;
/** Small totals need more decimals than large ones or they all read $0.00. */
function money(v: number): string {
  if (v >= 100) return `$${v.toFixed(0)}`;
  if (v >= 1) return `$${v.toFixed(2)}`;
  if (v >= 0.01) return `$${v.toFixed(3)}`;
  // Trailing zeros on a five-decimal figure read as precision that is not
  // there — $0.00100 for what is simply a tenth of a cent.
  return `$${v.toFixed(5).replace(/0+$/, '')}`;
}

const defaults = Object.fromEntries(
  orderedProviders
    .map((p) => [p.key, defaultModelFor(p.key)?.slug])
    .filter(([, slug]) => slug)
);

const countingAnswer = exact
  ? `Yes. ${provider.name} publishes its tokenizer, so the count is produced by running the real encoder on your text in your browser — the same one ${provider.name} bills against.`
  : `No. ${provider.name} does not publish a tokenizer, so the count is OpenAI's encoder run on your text and multiplied by ${drift}, the ratio ${provider.name} publishes for its own family. Treat it as ±10%, and never as an invoice.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `How many tokens is 1,000 words in ${provider.brand}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `About ${per1000Words.toLocaleString()} tokens — roughly ${tokensPerWord.toFixed(2)} tokens per word of English prose, or one token per ${charsPerToken.toFixed(1)} characters. Code, JSON and non-English text run denser and produce more tokens for the same word count.`,
      },
    },
    {
      '@type': 'Question',
      name: `Is this ${provider.brand} token count exact?`,
      acceptedAnswer: { '@type': 'Answer', text: countingAnswer },
    },
    {
      '@type': 'Question',
      name: `How much does 1M input tokens cost on ${provider.brand}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `From ${formatPrice(cheapest.input)} on ${cheapest.name}, the cheapest of the ${list.length} ${provider.brand} models listed here. Output tokens are billed separately and cost more — ${formatPrice(cheapest.output)} per million on the same model.`,
      },
    },
  ],
};
---

<Base
  title={seoTitle(`${provider.brand} token counter`, `${list.length} models priced`)}
  description={seoDescription(`Count the tokens in any prompt and see what it costs across ${list.length} ${provider.brand} models. Runs in your browser, nothing is uploaded. Prices synced ${updatedAt}.`)}
  jsonLd={jsonLd}
  breadcrumbs={[
    ['Token counters', '/token-counter/'],
    [`${provider.brand} token counter`, `/token-counter/${provider.slug}`],
  ]}
>
  <section class="wrap page">
    <span class="eyebrow"
      >Token counter · {provider.brand} · {list.length} models · synced {updatedAt}</span
    >
    <h1>{provider.brand} token counter</h1>
    <p class="lede">
      Paste a prompt to see how many tokens {provider.brand} bills it as, and what
      that costs on every {provider.brand} model{
        provider.brand !== provider.name && ` ${provider.name} publishes a rate for`
      }. The tokenizer runs in your browser — nothing you paste leaves the page.
    </p>

    <Ledger
      client:load
      models={models}
      providers={orderedProviders}
      defaults={defaults}
      active={[provider.key]}
    />

    <dl class="facts">
      <div>
        <dt>Counting</dt>
        <dd>
          <span class={`badge badge--${provider.counting}`}>{provider.counting}</span>
        </dd>
        <dd class="facts__who">
          {exact ? 'public tokenizer' : `OpenAI encoder × ${drift}`}
        </dd>
      </div>
      <div>
        <dt>Tokens per word</dt>
        <dd class="mono">{tokensPerWord.toFixed(2)}</dd>
        <dd class="facts__who">English prose</dd>
      </div>
      <div>
        <dt>1,000 words</dt>
        <dd class="mono">≈ {per1000Words.toLocaleString()}</dd>
        <dd class="facts__who">tokens</dd>
      </div>
      <div>
        <dt>Cheapest input</dt>
        <dd class="mono">{formatPrice(cheapest.input)}</dd>
        <dd class="facts__who">{cheapest.name}</dd>
      </div>
    </dl>

    <h2>What a given token count costs on {provider.brand}</h2>
    <p>
      Input tokens only, in USD, at current list rates. Output is billed
      separately and always costs more — the
      <a href={`/pricing/${provider.slug}`}>{provider.brand} pricing page</a> has
      both rates for all {list.length} models.
    </p>

    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Model</th>
            {VOLUMES.map((v) => (
              <th scope="col" class="num">{v.toLocaleString()}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {table.map((m) => (
            <tr>
              <td><a href={`/models/${m.slug}`}>{m.name}</a></td>
              {VOLUMES.map((v) => (
                <td class="num">{money(cost(m.input, v))}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="sub">How {provider.brand} counts a token</h2>
    <p>
      A token is not a word and not a character. Common words are usually one
      token, rarer ones split into pieces, and the spaces and punctuation
      between them are counted too. On the reference paragraph this page
      measures against, {provider.brand} works out at
      <strong>{tokensPerWord.toFixed(2)} tokens per word</strong>, or one token
      per {charsPerToken.toFixed(1)} characters of English prose. Code, JSON and
      languages that do not use the Latin alphabet all run denser — expect more
      tokens for the same word count, sometimes twice as many.
    </p>
    <p>
      {exact ? (
        <>
          {provider.name} publishes its tokenizer, so the number above is not an
          approximation: the real encoder runs on your text, in your browser,
          and returns what {provider.name} would bill. The token chips under the
          box are the actual pieces it split your prompt into.
        </>
      ) : (
        <>
          {provider.name} does not publish a tokenizer. Nobody outside OpenAI
          does. So the honest description of this count is: OpenAI's encoder run
          on your text, multiplied by <strong>{drift}</strong> — the ratio
          {' '}{provider.name} publishes for its own family. It is close enough
          to choose a model on and to size a budget with, and it is wrong enough
          that you should not reconcile a bill against it. That is why the
          badge says <em>estimated</em> rather than a number pretending to be
          exact.
        </>
      )}
    </p>

    <h2 class="sub">Questions</h2>
    <dl class="qa">
      {jsonLd.mainEntity.map((q) => (
        <div>
          <dt>{q.name}</dt>
          <dd>{q.acceptedAnswer.text}</dd>
        </div>
      ))}
    </dl>

    <h2 class="sub">Token counters for other providers</h2>
    <ul class="chips">
      {orderedProviders
        .filter((p) => p.key !== provider.key)
        .map((p) => (
          <li>
            <a href={`/token-counter/${p.slug}`}>{p.brand} token counter</a>
          </li>
        ))}
    </ul>
  </section>
</Base>

<style>
  .page {
    padding-top: 3rem;
  }
  .lede {
    font-size: 1.05rem;
    color: var(--ink-soft);
    max-width: 62ch;
    margin: 0.9rem 0 2rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 2.5rem 0;
    padding: 1.25rem 0;
    border-block: 1px solid var(--rule);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .facts dd {
    margin: 0.3rem 0 0;
    font-size: 1.3rem;
    font-weight: 600;
  }
  .facts__who {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ink-faint);
    font-family: var(--font-mono);
  }
  .sub {
    margin-top: 3rem;
  }
  .qa {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 1.25rem;
    max-width: 68ch;
  }
  .qa dt {
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .qa dd {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips a {
    display: inline-block;
    font-size: 0.85rem;
    text-decoration: none;
    padding: 0.3em 0.7em;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--ink-soft);
  }
  .chips a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
</style>
