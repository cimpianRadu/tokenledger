---
/**
 * The brand mark: price over tokens, as a fraction.
 *
 * The division rule carries the accent colour because it is the "per" — the
 * same word the wordmark accents. Everything else inherits `currentColor`, so
 * one file serves the header, the footer and either theme.
 *
 * `public/favicon.svg` is the standalone twin, with the palette hardcoded
 * because a favicon has no page to inherit from. Keep the two in step.
 */
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3v10.6"></path>
    <path
      d="M15 6.1c-.7-1-1.9-1.5-3.2-1.4-1.5.1-2.6.8-2.6 1.9 0 1.2 1.1 1.7 2.8 2 1.8.3 3.1.8 3.1 2.1 0 1.2-1.3 2-2.9 2-1.4 0-2.6-.5-3.2-1.5"
    ></path>
    <path class="mark__rule" d="M2.6 15.4h18.8"></path>
  </g>
  <g fill="currentColor">
    <rect x="2.6" y="17.8" width="6.2" height="3.6" rx="1.2"></rect>
    <rect x="10.2" y="17.8" width="4.2" height="3.6" rx="1.2"></rect>
    <rect x="15.8" y="17.8" width="5.6" height="3.6" rx="1.2"></rect>
  </g>
</svg>

<style>
  .mark {
    flex: none;
  }
  .mark__rule {
    stroke: var(--accent);
  }
</style>
