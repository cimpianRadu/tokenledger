# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Free key from https://artificialanalysis.ai/login — 1,000 requests/day, and
# a sync spends exactly one. Only `npm run sync:bench` reads it: the built site
# ships committed JSON, so this never needs to exist in Vercel or any other
# deploy environment.
ARTIFICIALANALYSIS_API_KEY=
