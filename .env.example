# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Free key from https://artificialanalysis.ai/login — 1,000 requests/day, and
# a sync spends exactly one. Only `npm run sync:bench` reads it: the built site
# ships committed JSON, so this never needs to exist in Vercel or any other
# deploy environment.
ARTIFICIALANALYSIS_API_KEY=

# Resend, pentru rapoartele și alertele rutinelor (scripts/notify-email.mjs).
# Aceeași cheie ca la celelalte proiecte — Resend e per cont, nu per site.
# Fără ea scriptul iese cu cod 2 și rutina trimite raportul pe altă cale.
RESEND_API_KEY=
# Expeditor. Lăsat gol = onboarding@resend.dev, care scrie doar către adresa
# contului Resend. pricepertoken.ai nu e domeniu verificat acolo; pentru alt
# destinatar pune un domeniu care e, de exemplu:
# RESEND_FROM="Price Per Token <contact@gaseste-dentist.ro>"
RESEND_FROM=
