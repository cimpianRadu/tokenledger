---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { providers } from '../lib/models';

interface Props {
  title: string;
  description: string;
  /** Optional JSON-LD object rendered into the head. */
  jsonLd?: Record<string, unknown>;
  /** [label, href] pairs after Home; emits BreadcrumbList for rich results. */
  breadcrumbs?: Array<[string, string]>;
}

const { title, description, jsonLd, breadcrumbs } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tokenledger.dev');
const crumbLd = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [['Home', '/'], ...breadcrumbs].map(([name, href], i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name,
    item: new URL(href, canonical).href,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Token Ledger" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL('/og.png', canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', canonical).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600&display=swap"
      />
    </noscript>
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )}
    {crumbLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(crumbLd)}
      />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="wordmark" href="/">token<span>ledger</span></a>
        <nav class="nav" aria-label="Providers">
          {providers.slice(0, 5).map((p) => (
            <a href={`/pricing/${p.slug}`}>{p.brand}</a>
          ))}
          <a href="/compare/">Compare</a>
          <a href="/models">All models</a>
          <a href="/methodology">Methodology</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
